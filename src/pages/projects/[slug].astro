---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import FactsSidebar from "../../components/FactsSidebar.astro";
import Placeholder from "../../components/Placeholder.astro";
import { getVisibleProjects, type VisibleProject } from "../../lib/collection";

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project) => ({ params: { slug: project.entry.id }, props: { project } }));
}

interface Props {
  project: VisibleProject;
}

const { entry, cover } = Astro.props.project;
const { title, tagline, lang } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={tagline} lang={lang} ogImage={cover ?? undefined}>
  <div class="container">
    <a class="back" href="/" lang="en">← All projects</a>
    <div class="hero">
      {
        cover ? (
          <img src={cover} alt={`Screenshot of ${title}`} width="1280" height="800" />
        ) : (
          <Placeholder slug={entry.id} title={title} />
        )
      }
    </div>
    <div class="detail">
      <header class="head">
        <h1>{title}</h1>
        <p class="tagline muted">{tagline}</p>
      </header>
      <FactsSidebar data={entry.data} />
      <article class="prose">
        <Content />
      </article>
    </div>
  </div>
</Base>

<style>
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-block: 8px 16px;
  }
  .back:hover {
    color: var(--fg);
  }
  .hero {
    aspect-ratio: 16 / 10;
    max-height: 560px;
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .hero :global(.placeholder) {
    height: 100%;
  }
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin-top: 24px;
  }
  .head h1 {
    font-size: 2rem;
    margin: 0 0 4px;
  }
  .tagline {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .prose {
    max-width: 42em;
    overflow-wrap: break-word;
  }
  .prose :global(h2) {
    font-size: 1.2rem;
    margin: 1.6em 0 0.4em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(pre) {
    overflow-x: auto;
    padding: 12px;
    border-radius: 8px;
  }
  @media (min-width: 900px) {
    .detail {
      grid-template-columns: minmax(0, 1fr) 260px;
      column-gap: 40px;
    }
    .head {
      grid-column: 1;
      grid-row: 1;
    }
    .prose {
      grid-column: 1;
      grid-row: 2;
    }
    .detail > :global(.facts) {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      position: sticky;
      top: 24px;
    }
  }
</style>
